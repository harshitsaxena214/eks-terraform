# =============================================================================
# environments/dev/infra/terraform.tfvars.example
#
# Copy this to terraform.tfvars and set a real db_password.
# terraform.tfvars is gitignored — never commit it.
# =============================================================================

aws_region   = "us-east-1"
project_name = "eks-three-stage"
environment  = "dev"

# Networking
vpc_cidr              = "10.0.0.0/16"
public_subnet_cidrs   = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs  = ["10.0.3.0/24", "10.0.4.0/24"]
database_subnet_cidrs = ["10.0.5.0/24", "10.0.6.0/24"]

# EKS — DEV: minimal (1 node, t3.medium)
kubernetes_version = "1.29"
node_instance_type = "t3.medium"
node_desired_size  = 1
node_min_size      = 1
node_max_size      = 2

# RDS — DEV: smallest instance, single-AZ, minimal backups
db_name           = "appdb"
db_username       = "dbadmin"
db_password       = "CHANGE_ME_use_a_strong_password_here"
db_instance_class = "db.t3.micro"
