# =============================================================================
# environments/prod/infra/terraform.tfvars.example
# =============================================================================

aws_region   = "us-east-1"
project_name = "eks-three-stage"
environment  = "prod"

# Networking — 10.2.x.x to avoid overlap with DEV (10.0) and STAGING (10.1)
vpc_cidr              = "10.2.0.0/16"
public_subnet_cidrs   = ["10.2.1.0/24", "10.2.2.0/24"]
private_subnet_cidrs  = ["10.2.3.0/24", "10.2.4.0/24"]
database_subnet_cidrs = ["10.2.5.0/24", "10.2.6.0/24"]

# EKS — PROD: 3 nodes, t3.large
kubernetes_version = "1.29"
node_instance_type = "t3.large"
node_desired_size  = 3
node_min_size      = 3
node_max_size      = 5

# RDS — PROD: db.t3.medium, Multi-AZ, 7 day backup, deletion_protection=true
db_name           = "appdb"
db_username       = "dbadmin"
db_password       = "CHANGE_ME_use_a_very_strong_password_in_production"
db_instance_class = "db.t3.medium"
