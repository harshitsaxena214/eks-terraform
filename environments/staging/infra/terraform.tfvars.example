# =============================================================================
# environments/staging/infra/terraform.tfvars.example
# =============================================================================

aws_region   = "us-east-1"
project_name = "eks-three-stage"
environment  = "staging"

# Networking — 10.1.x.x to avoid overlap with DEV (10.0) and PROD (10.2)
vpc_cidr              = "10.1.0.0/16"
public_subnet_cidrs   = ["10.1.1.0/24", "10.1.2.0/24"]
private_subnet_cidrs  = ["10.1.3.0/24", "10.1.4.0/24"]
database_subnet_cidrs = ["10.1.5.0/24", "10.1.6.0/24"]

# EKS — STAGING: 2 nodes, t3.medium
kubernetes_version = "1.29"
node_instance_type = "t3.medium"
node_desired_size  = 2
node_min_size      = 2
node_max_size      = 3

# RDS — STAGING: db.t3.small, 3 day backup
db_name           = "appdb"
db_username       = "dbadmin"
db_password       = "CHANGE_ME_use_a_strong_password_here"
db_instance_class = "db.t3.small"
